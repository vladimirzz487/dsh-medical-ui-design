<!-- 合规样例：只使用 token，用于审查脚本自检（应零命中） -->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontSize="14" Background="{StaticResource Brush.Bg}">
  <Grid>
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Style="{StaticResource Text.Secondary}" Text="待处理"/>
        <TextBlock Style="{StaticResource Text.Stat}" Text="{Binding PendingCount}"/>
        <DataGrid Style="{StaticResource DataGrid.Medical}" ItemsSource="{Binding Rows}"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
